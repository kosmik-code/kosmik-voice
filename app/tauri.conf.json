{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kosmik Voice",
  "mainBinaryName": "kosmik-voice",
  "identifier": "com.kosmik.voice",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Kosmik",
    "homepage": "https://github.com/kosmik-code/kosmik-voice",
    "copyright": "© 2026 Kosmik. MIT license.",
    "category": "Utility",
    "shortDescription": "Discord voice overlay for OBS",
    "longDescription": "Show who's talking in your Discord call on your stream. Runs in the tray and serves the editor and the OBS overlays on this PC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCREJFNzEzMDQ3MTA0QzkKUldUSkJIRUVFK2ZiMjQ5QTVDMUhLSGlKR2xmbkk1RWJoYjR5bUN4RjYvSG95U2ZReWpaZ2JUbUIK",
      "endpoints": [
        "https://github.com/kosmik-code/kosmik-voice/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
